# Copy to .env for local development

# Supabase (required)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Site URL (optional — used for auth redirects; defaults to https://pelreports.ca)
# REACT_APP_SITE_URL=http://localhost:3000

# Google Maps (optional — geofence map in Facility Management)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Branding (optional)
REACT_APP_COMPANY_NAME=Pluming Eagle Lodge
REACT_APP_COMPANY_TAGLINE=Empowering The Next Generation
REACT_APP_LOGO_PATH=/images/pellogo.png

# Build / legacy (optional)
REACT_APP_BACKEND=false
PUBLIC_URL=/
